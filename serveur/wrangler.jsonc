{
  // Serveur gratuit de RetoucheProAI (Cloudflare Workers) : récupère les vidéos à partir d'un lien, vérifie les abonnements (v6),
  // reçoit le diagnostic anonyme (v7, base D1 « retouche-diag »)
  "name": "retouche-serveur",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "keep_vars": true,
  // base créée le 5 nov. 2026 (wrangler d1 create retouche-diag --location weur)
  "d1_databases": [{ "binding": "DIAG", "database_name": "retouche-diag", "database_id": "0a3bb17b-d047-46b9-a188-82dc7e66fbfe" }]
}
